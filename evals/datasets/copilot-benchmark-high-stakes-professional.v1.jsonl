{"id":"benchmark-financebench-source-authority-001","suite":"benchmark-high-stakes-professional","input":{"messages":[{"role":"user","content":"Example Energy 2025 年资本开支到底是 1.2 亿还是 1.5 亿美元？请核对原始披露，不要用博客转述。"}],"search_results":[{"title":"Example Energy Form 10-K","url":"https://filings.example/example-energy/2025-10k#capex","content":"Cash paid for property, plant and equipment in 2025 was USD 120 million.","score":0.99},{"title":"Energy growth blog","url":"https://blog.example/example-energy-capex","content":"The company spent about USD 150 million on expansion.","score":0.61}],"script":[{"agent":"copilot","action":"tool","tool":"transfer_to_agent","arguments":{"agent_name":"research_assistant"}},{"agent":"research_assistant","action":"tool","tool":"TavilySearchTool","arguments":{"query":"Example Energy 2025 10-K capital expenditures cash paid property plant equipment"}},{"agent":"research_assistant","action":"answer","content":"原始 10-K 披露的 2025 年购置物业、厂房和设备现金支出为 1.2 亿美元。博客的 1.5 亿美元表述口径不明，不能替代原始披露。[10-K](https://filings.example/example-energy/2025-10k#capex)"}]},"expected":{"intent":{"domain":"finance","task_type":"financial_analysis","risk":"medium","requires_fresh_data":true},"route":{"mode":"delegate","agentId":"research_assistant"},"tools":{"required":["transfer_to_agent","TavilySearchTool"],"require_success":["TavilySearchTool"]},"response":{"language":"zh","min_chars":75,"must_include":["1.2 亿美元","口径不明","原始披露","https://filings.example/example-energy/2025-10k#capex"],"must_not_include":["资本开支是 1.5 亿美元"]},"trace":{"required_kinds":["CHAIN","AGENT RUN","SPAN","GENERATION","TOOL CALL"]}},"metadata":{"dataset_version":"copilot-benchmark-high-stakes-professional.v1","task_type":"financial_source_reconciliation","risk":"high","source":"benchmark-inspired-original","label_status":"specification-derived","evaluation_dimension":"vertical_capability","capability":"financial_source_authority","domain":"finance","difficulty":"advanced","interaction_pattern":"tool_augmented"