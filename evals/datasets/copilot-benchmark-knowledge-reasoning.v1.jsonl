{"id":"bench-ifeval-three-bullets-001","suite":"benchmark-knowledge-reasoning","input":{"messages":[{"role":"user","content":"用且仅用 3 个项目符号说明远程会议的会前准备。每行必须以“- ”开头；不要使用“高效”这个词；不要增加标题或结尾。"}],"script":[{"agent":"copilot","action":"answer","content":"- 提前发送议程、目标和必要材料\n- 检查网络、麦克风与屏幕共享权限\n- 明确参会人角色、时区和会议时长"}]},"expected":{"route":{"mode":"direct","agentId":null},"tools":{"forbidden":["transfer_to_agent","TavilySearchTool"]},"response":{"language":"zh","exact_line_count":3,"exact_bullet_count":3,"must_not_include":["高效","准备事项","总结"],"reference_answer":"仅包含三个项目符号，分别覆盖议程材料、技术检查和参会安排。"},"performance":{"max_model_calls":2,"max_tool_executions":0,"max_total_tokens":2200,"live_e2e_budget_ms":10000},"trace":{"required_kinds":["CHAIN","AGENT RUN","SPAN","GENERATION"]}},"metadata":{"dataset_version":"copilot-benchmark-knowledge-reasoning.v1","task_type":"verifiable_instruction_following","risk":"low","source":"benchmark-inspired-original","label_status":"specification-derived","evaluation_dimension":"general_knowledge","capability":"compound_constraint_adherence","domain":"instruction_following","difficulty":"advanced","interaction_pattern":"single_turn","decision_use":"release_gate","live_eligible":false,"benchmark_family":"ifeval","benchmark_task":"multiple verifiable constraints","benchmark_reference_id":"ifeval","benchmark_adaptation":"methodology-inspired-original","tags":["benchmark","instruction-following","format"]}}
