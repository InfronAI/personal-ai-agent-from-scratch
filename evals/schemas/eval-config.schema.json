{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-copilot.local/schemas/copilot-eval-config.v1.json",
  "title": "copilot Eval 配置 v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "benchmarkCatalog", "datasets", "defaults", "profiles", "comparison", "calibration", "goldenSet", "langfuse"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "copilot-eval-config.v1"},
    "project": {"type": "string", "minLength": 1},
    "benchmarkCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "version"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "datasets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "version", "dimension", "purpose"],
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "dimension": {"enum": ["product_contract", "general_knowledge", "vertical_capability", "performance_resilience", "safety_compliance", "agent_capability"]},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    },
    "defaults": {"$ref": "#/$defs/defaultSettings"},
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/profile"}
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failOnCoverageChange", "failOnCandidateBlockingFailure", "outputDirectory"],
      "properties": {
        "failOnCoverageChange": {"type": "boolean"},
        "failOnCandidateBlockingFailure": {"type": "boolean"},
        "outputDirectory": {"type": "string", "minLength": 1}
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredLabelStatus", "positiveClass", "requireAllAnnotationsMatched", "outputDirectory"],
      "properties": {
        "requiredLabelStatus": {"const": "human-reviewed"},
        "positiveClass": {"const": "fail"},
        "requireAllAnnotationsMatched": {"type": "boolean"},
        "outputDirectory": {"type": "string", "minLength": 1}
      }
    },
    "goldenSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "candidateTable", "evidenceTable", "goldenTable", "evidenceSchemaVersion", "evidenceScope", "sessionBoundary", "requiredReviewStatus", "requiredLabelStatus", "export"],
      "properties": {
        "source": {"const": "user-feedback"},
        "candidateTable": {"type": "string", "minLength": 1},
        "evidenceTable": {"const": "eval_evidence_snapshots"},
        "goldenTable": {"type": "string", "minLength": 1},
        "evidenceSchemaVersion": {"const": "copilot-eval-evidence.v1"},
        "evidenceScope": {"const": "target-trace+session-prefix"},
        "sessionBoundary": {"const": "through-evaluated-turn"},
        "requiredReviewStatus": {"const": "approved"},
        "requiredLabelStatus": {"const": "human-reviewed"},
        "export": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "datasetVersion"],
          "properties": {
            "file": {"type": "string", "minLength": 1},
            "datasetVersion": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "langfuse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetName", "datasetDescription", "sync", "experiment"],
      "properties": {
        "datasetName": {"type": "string", "minLength": 1},
        "datasetDescription": {"type": "string", "minLength": 1},
        "sync": {
          "type": "object",
          "additionalProperties": false,
          "required": ["datasetIds", "liveEligibleOnly", "concurrency"],
          "properties": {
            "datasetIds": {"$ref": "#/$defs/nonEmptyStringArray"},
            "liveEligibleOnly": {"type": "boolean"},
            "concurrency": {"type": "integer", "minimum": 1, "maximum": 10}
          }
        },
        "experiment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "description", "maxConcurrency", "outputDirectory"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "description": {"type": "string", "minLength": 1},
            "maxConcurrency": {"type": "integer", "minimum": 1, "maximum": 10},
            "outputDirectory": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "selectors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cases": {"$ref": "#/$defs/nonEmptyStringArray"},
        "suites": {"$ref": "#/$defs/nonEmptyStringArray"},
        "tags": {"$ref": "#/$defs/nonEmptyStringArray"},
        "risks": {"type": "array", "items": {"enum": ["low", "medium", "high"]}, "uniqueItems": true},
        "taskTypes": {"$ref": "#/$defs/nonEmptyStringArray"},
        "labelStatuses": {"type": "array", "items": {"enum": ["specification-derived", "code-derived", "draft", "human-reviewed"]}, "uniqueItems": true},
        "liveEligibleOnly": {"type": "boolean"}
      }
    },
    "runSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extends": {"type": "string", "minLength": 1},
        "datasetIds": {"$ref": "#/$defs/nonEmptyStringArray"},
        "selectors": {"$ref": "#/$defs/selectors"},
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {"enum": ["offline-scripted", "live"]},
            "traceLive": {"type": "boolean"}
          }
        },
        "judge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "catalog": {"type": "string", "minLength": 1},
            "model": {"type": "string", "minLength": 1},
            "definitionIds": {"$ref": "#/$defs/nonEmptyStringArray"},
            "temperature": {"type": "number", "minimum": 0, "maximum": 2},
            "maxTokens": {"type": "integer", "minimum": 100, "maximum": 16384}
          }
        },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "failSeverities": {"type": "array", "items": {"enum": ["blocking", "diagnostic"]}, "contains": {"const": "blocking"}, "uniqueItems": true},
            "diagnosticDebtRatchet": {"type": "boolean"},
            "baseline": {"type": "string", "minLength": 1},
            "minimumCases": {"type": "integer", "minimum": 1}
          }
        },
        "report": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "directory": {"type": "string", "minLength": 1},
            "output": {"type": ["string", "null"]}
          }
        }
      }
    },
    "defaultSettings": {
      "allOf": [
        {"$ref": "#/$defs/runSettings"},
        {"required": ["datasetIds", "selectors", "execution", "judge", "gate", "report"]}
      ]
    },
    "profile": {
      "allOf": [
        {"$ref": "#/$defs/runSettings"},
        {
          "type": "object",
          "properties": {"extends": {"type": "string", "minLength": 1}}
        }
      ]
    }
  }
}
