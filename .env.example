# 运行环境
NODE_ENV=development
HOST=127.0.0.1
PORT=9093
COPILOT_RELEASE=3.0.0
COPILOT_SESSION_SECRET=replace-with-at-least-32-random-characters
COPILOT_AUTH_MODE=local-username
# 本地用户名模式仅用于单机 MVP，不提供密码认证。
# 本地开发允许首个配置管理员通过 Web 保存实例级模型配置；生产环境设为 false。
COPILOT_ALLOW_WEB_CONFIGURATION=true
COPILOT_RUNTIME_CONFIG_PATH=./.data/runtime-settings.json
# 生产环境入口模式：
# COPILOT_AUTH_MODE=trusted-header
# COPILOT_TRUSTED_USER_HEADER=x-authenticated-user
# COPILOT_TRUSTED_TENANT_HEADER=x-authenticated-tenant
COPILOT_ALLOWED_ORIGINS=http://127.0.0.1:9093

# 容量与执行预算
COPILOT_REQUEST_TIMEOUT_MS=120000
COPILOT_REQUESTS_PER_MINUTE=30
COPILOT_MAX_CONCURRENT_PER_USER=2
COPILOT_ROOT_MAX_ITERATIONS=3
COPILOT_SPECIALIST_MAX_ITERATIONS=4
COPILOT_MAX_TOOL_CALLS=12
COPILOT_MAX_NO_PROGRESS_ITERATIONS=2
COPILOT_AGENT_DEADLINE_MS=110000
COPILOT_ROUTING_CONFIG=./config/routing.config.json

# 单实例持久化存储；生产环境必须把 .data 挂载到持久卷。
COPILOT_DATABASE_PATH=./.data/copilot.sqlite
COPILOT_HISTORY_TURNS=12
COPILOT_MEMORY_RETENTION_DAYS=365
COPILOT_MEMORY_PROFILE_RETENTION_DAYS=730
COPILOT_MEMORY_CANDIDATES=250
COPILOT_MEMORY_RESULTS=5
COPILOT_MEMORY_CONTEXT_CHARACTERS=4000
COPILOT_MEMORY_RECENCY_HALF_LIFE_DAYS=90
COPILOT_MEMORY_MINIMUM_SCORE=0.16

# 生成或上传的 Artifact：单文件 20 MiB、单轮 30 MiB；单轮最多选择 10 个附件。
COPILOT_ARTIFACT_DIRECTORY=./.data/artifacts
COPILOT_MAX_ARTIFACT_BYTES=20971520
COPILOT_MAX_TURN_ATTACHMENT_BYTES=31457280
COPILOT_MAX_ARTIFACT_SOURCE_CHARACTERS=120000
COPILOT_ARTIFACT_LIST_LIMIT=50
# PDF 输出可选字体；Linux 环境应显式配置支持中日韩字符的字体。
# COPILOT_DOCUMENT_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc

# OpenAI-compatible LLM Gateway 与 Tavily-compatible Search；实际供应商只在本层配置。
LLM_GATEWAY_API_KEY=your-llm-gateway-api-key
LLM_GATEWAY_BASE_URL=https://llm.onerouter.pro/v1
# Intention Layer 默认固定使用低延迟模型；用户在 Web UI 的选择不会覆盖它。
LLM_GATEWAY_INTENTION_MODEL=google/gemini-3.1-flash-lite
LLM_GATEWAY_TIMEOUT_MS=60000
LLM_GATEWAY_MAX_RETRIES=2
LLM_GATEWAY_COMPLETION_RETRIES=2
LLM_GATEWAY_MAX_COMPLETION_TOKENS=4800
# 按需启用真实 Eval Judge；示例值与 Eval 配置中的系统预设保持一致，可在 Web 运行配置中覆盖。
COPILOT_EVAL_CONFIG=./evals/eval.config.json
COPILOT_EVAL_PROFILE=local
COPILOT_EVAL_OUTPUT_DIRECTORY=results
COPILOT_EVAL_JUDGE_MODEL=openai/gpt-4o
# Search 使用独立的端点与凭证配置；即使平台发放同一个 Key，也应在这里显式填写。
WEB_SEARCH_API_KEY=your-search-api-key
WEB_SEARCH_BASE_URL=https://search.onerouter.pro/v1/tavily
WEB_SEARCH_TIMEOUT_MS=15000
WEB_SEARCH_MAX_RETRIES=2

# Langfuse 日志投递；默认使用官方 EU Cloud，也可改为其他 Region 或自托管地址。
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=personal-copilot@3.0.0
LANGFUSE_SAMPLE_RATE=1
LANGFUSE_FLUSH_AT=20
LANGFUSE_FLUSH_INTERVAL=5
LANGFUSE_TIMEOUT=10
COPILOT_LANGFUSE_EVAL_DATASET=personal-copilot-live-eval-v3

# Trace 详情代理；生产环境严禁允许读取不属于当前用户的 Trace。
COPILOT_TRACE_API_BASE_URL=http://127.0.0.1:9092/api/v1
COPILOT_TRACE_TEAM_ID=otel-auth:replace-with-endpoint-hash
COPILOT_TRACE_KEY_ID=langfuse:replace-with-endpoint-hash
COPILOT_ALLOW_UNOWNED_TRACES=false
