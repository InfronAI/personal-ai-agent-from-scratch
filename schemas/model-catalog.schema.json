{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-copilot.local/schemas/model-catalog.v3.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "defaultModelId", "models"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "copilot-model-catalog.v3"},
    "catalogVersion": {"type": "string", "minLength": 1},
    "defaultModelId": {"$ref": "#/$defs/id"},
    "models": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "modelAlias", "displayName", "providerLabel", "description", "mark", "modalities", "recommendedFor"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["selection-mode", "answer-model", "control-model"]},
          "modelAlias": {"$ref": "#/$defs/id"},
          "displayName": {"type": "string", "minLength": 1},
          "providerLabel": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "mark": {"$ref": "#/$defs/id"},
          "modalities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["text", "image", "file", "audio", "video"]}},
          "recommendedFor": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"}
  }
}
