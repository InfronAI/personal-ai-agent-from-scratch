{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-copilot.local/schemas/workflow-config.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflowVersion", "invocationName", "agentRegistry", "routingConfiguration", "stages"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "copilot-workflow-config.v1"},
    "workflowVersion": {"type": "string", "minLength": 1},
    "invocationName": {"type": "string", "minLength": 1},
    "agentRegistry": {"type": "string", "minLength": 1},
    "routingConfiguration": {"type": "string", "minLength": 1},
    "stages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
